{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job Submission",
  "type": "object",
  "required": ["type", "input_format", "input_url"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["prep", "convert"]
    },
    "input_format": {
      "type": "string",
      "enum": ["pdf", "epub"]
    },
    "input_url": {
      "type": "string",
      "description": "file:// URL or absolute path. For convert jobs, this is the package_url from the prep job."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "author": {"type": "string"},
        "language": {"type": "string"},
        "customer_id": {"type": "string"},
        "performance_style": {"type": "string"},
        "voice_recipe": {"type": "object"}
      }
    }
  }
}
