  "elements": [
    { "type": "text", "id": "t_title", "x": 170, "y": 30, "width": 660, "height": 35, "text": "OCR Text Escalation — how damage gets resolved", "fontSize": 28, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "OCR Text Escalation — how damage gets resolved", "autoResize": true },
    { "type": "text", "id": "t_sub", "x": 110, "y": 70, "width": 760, "height": 22, "text": "deterministic first · heuristic second · inference last — the escalation principle applied (chain #62 → #73 state)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#757575", "originalText": "deterministic first · heuristic second · inference last — the escalation principle applied (chain #62 → #73 state)", "autoResize": true },

    { "type": "rectangle", "id": "r_input", "x": 320, "y": 100, "width": 340, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{ "id": "t_input", "type": "text" }] },
    { "type": "text", "id": "t_input", "x": 325, "y": 110, "width": 330, "height": 50, "text": "RAW OCR TEXT\nTesseract · every page + confidence", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_input", "originalText": "RAW OCR TEXT\nTesseract · every page + confidence", "autoResize": true },

    { "type": "arrow", "id": "a1", "x": 490, "y": 170, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_input", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_gate", "fixedPoint": [0.5, 0] }, "boundElements": [{ "id": "t_a1", "type": "text" }] },
    { "type": "text", "id": "t_a1", "x": 497, "y": 188, "width": 90, "height": 20, "text": "every page", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "textAlign": "center", "verticalAlign": "middle", "containerId": "a1", "originalText": "every page", "autoResize": true },

    { "type": "rectangle", "id": "r_gate", "x": 320, "y": 230, "width": 340, "height": 100, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_gate", "type": "text" }] },
    { "type": "text", "id": "t_gate", "x": 325, "y": 240, "width": 330, "height": 80, "text": "PAGE QUALITY GATE — heuristic\nconf < 85 · dict-share < 0.90\nclipped-line / digit-letter junk flags a page\nall pages · ~ms per page", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_gate", "originalText": "PAGE QUALITY GATE — heuristic\nconf < 85 · dict-share < 0.90\nclipped-line / digit-letter junk flags a page\nall pages · ~ms per page", "autoResize": true },

    { "type": "arrow", "id": "a_pass", "x": 260, "y": 280, "width": 60, "height": 0, "points": [[0,0],[60,0]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_pass", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "r_gate", "fixedPoint": [0, 0.5] }, "boundElements": [{ "id": "t_apass", "type": "text" }] },
    { "type": "text", "id": "t_apass", "x": 262, "y": 258, "width": 56, "height": 20, "text": "pass", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "textAlign": "center", "verticalAlign": "middle", "containerId": "a_pass", "originalText": "pass", "autoResize": true },

    { "type": "rectangle", "id": "r_pass", "x": 30, "y": 235, "width": 230, "height": 90, "roundness": { "type": 3 }, "backgroundColor": "#c3fae8", "fillStyle": "solid", "boundElements": [{ "id": "t_pass", "type": "text" }] },
    { "type": "text", "id": "t_pass", "x": 35, "y": 245, "width": 220, "height": 70, "text": "PASS = the book's own text\nships as-is, never repaired\n(same rule as text-layer pages)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_pass", "originalText": "PASS = the book's own text\nships as-is, never repaired\n(same rule as text-layer pages)", "autoResize": true },

    { "type": "text", "id": "note_blind", "x": 30, "y": 345, "width": 250, "height": 80, "text": "blind spot: a confident misread\npasses the gate ('almos', conf 94.9)\n→ caught downstream by the\nword-level rules + declaration", "fontSize": 14, "fontFamily": 1, "strokeColor": "#e67700", "originalText": "blind spot: a confident misread\npasses the gate ('almos', conf 94.9)\n→ caught downstream by the\nword-level rules + declaration", "autoResize": true },

    { "type": "arrow", "id": "a2", "x": 490, "y": 330, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_gate", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_llm", "fixedPoint": [0.5, 0] }, "boundElements": [{ "id": "t_a2", "type": "text" }] },
    { "type": "text", "id": "t_a2", "x": 497, "y": 348, "width": 170, "height": 34, "text": "flagged only\n18 of 60 pages", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "textAlign": "center", "verticalAlign": "middle", "containerId": "a2", "originalText": "flagged only\n18 of 60 pages", "autoResize": true },

    { "type": "rectangle", "id": "r_llm", "x": 320, "y": 400, "width": 340, "height": 90, "roundness": { "type": 3 }, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{ "id": "t_llm", "type": "text" }] },
    { "type": "text", "id": "t_llm", "x": 325, "y": 410, "width": 330, "height": 70, "text": "LLM CLEANUP — inference\nproposes repairs · flagged pages only\n(the efficiency gate)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_llm", "originalText": "LLM CLEANUP — inference\nproposes repairs · flagged pages only\n(the efficiency gate)", "autoResize": true },

    { "type": "arrow", "id": "a3", "x": 490, "y": 490, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_llm", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_verify", "fixedPoint": [0.5, 0] } },

    { "type": "rectangle", "id": "r_verify", "x": 320, "y": 560, "width": 340, "height": 110, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{ "id": "t_verify", "type": "text" }] },
    { "type": "text", "id": "t_verify", "x": 325, "y": 570, "width": 330, "height": 90, "text": "VERIFY-AND-REVERT — deterministic judge\ndigit_letter / clipped_line → keep\nall else reverts · every decision logged\n(kept 5 · refused 2 in this book)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_verify", "originalText": "VERIFY-AND-REVERT — deterministic judge\ndigit_letter / clipped_line → keep\nall else reverts · every decision logged\n(kept 5 · refused 2 in this book)", "autoResize": true },

    { "type": "arrow", "id": "a4", "x": 490, "y": 670, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_verify", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_sweep", "fixedPoint": [0.5, 0] }, "boundElements": [{ "id": "t_a4", "type": "text" }] },
    { "type": "text", "id": "t_a4", "x": 497, "y": 688, "width": 190, "height": 34, "text": "after parse — full\nbook corpus in hand", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "textAlign": "center", "verticalAlign": "middle", "containerId": "a4", "originalText": "after parse — full\nbook corpus in hand", "autoResize": true },

    { "type": "rectangle", "id": "r_sweep", "x": 320, "y": 740, "width": 340, "height": 110, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{ "id": "t_sweep", "type": "text" }] },
    { "type": "text", "id": "t_sweep", "x": 325, "y": 750, "width": 330, "height": 90, "text": "DETERMINISTIC REPAIR SWEEP\nfragment_completion #70: almos → almost\njoined_words #72*: didso → did so\nunique dictionary match + book witness · ms/book", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_sweep", "originalText": "DETERMINISTIC REPAIR SWEEP\nfragment_completion #70: almos → almost\njoined_words #72*: didso → did so\nunique dictionary match + book witness · ms/book", "autoResize": true },

    { "type": "text", "id": "note_star", "x": 690, "y": 745, "width": 280, "height": 150, "text": "* #72 disposition pending\n(the ungladly false split; guard\ndecision open)\n\nNOTE: the sweep runs AFTER the\nLLM pass — 'deterministic first'\nwould run it before; today it needs\nevery page parsed for the witness\ncorpus. The open ordering question.", "fontSize": 14, "fontFamily": 1, "strokeColor": "#e67700", "originalText": "* #72 disposition pending\n(the ungladly false split; guard\ndecision open)\n\nNOTE: the sweep runs AFTER the\nLLM pass — 'deterministic first'\nwould run it before; today it needs\nevery page parsed for the witness\ncorpus. The open ordering question.", "autoResize": true },

    { "type": "arrow", "id": "a5", "x": 490, "y": 850, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_sweep", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_declare", "fixedPoint": [0.5, 0] } },

    { "type": "rectangle", "id": "r_declare", "x": 320, "y": 920, "width": 340, "height": 110, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{ "id": "t_declare", "type": "text" }] },
    { "type": "text", "id": "t_declare", "x": 325, "y": 930, "width": 330, "height": 90, "text": "DECLARATION — deterministic inventory\nevery non-dictionary word in shipped text\nkept + refused + repairs → fidelity-report.json\n(179 declared · 0 unattributed)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_declare", "originalText": "DECLARATION — deterministic inventory\nevery non-dictionary word in shipped text\nkept + refused + repairs → fidelity-report.json\n(179 declared · 0 unattributed)", "autoResize": true },

    { "type": "arrow", "id": "a6", "x": 490, "y": 1030, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_declare", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_ship", "fixedPoint": [0.5, 0] } },

    { "type": "rectangle", "id": "r_ship", "x": 320, "y": 1100, "width": 340, "height": 80, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{ "id": "t_ship", "type": "text" }] },
    { "type": "text", "id": "t_ship", "x": 325, "y": 1110, "width": 330, "height": 60, "text": "SHIP — narration text\nall residuals declared, none silent", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_ship", "originalText": "SHIP — narration text\nall residuals declared, none silent", "autoResize": true },

    { "type": "text", "id": "note_eff", "x": 690, "y": 960, "width": 280, "height": 110, "text": "EFFICIENCY: cheap tiers decide\nfirst; the LLM sees only the 18\nflagged pages; the sweep is\n~ms per book; #66 would see\nonly declared + refused sites.\nCost scales with damage,\nnot book length.", "fontSize": 14, "fontFamily": 1, "strokeColor": "#e67700", "originalText": "EFFICIENCY: cheap tiers decide\nfirst; the LLM sees only the 18\nflagged pages; the sweep is\n~ms per book; #66 would see\nonly declared + refused sites.\nCost scales with damage,\nnot book length.", "autoResize": true },

    { "type": "arrow", "id": "a7", "x": 490, "y": 1180, "width": 0, "height": 70, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "strokeStyle": "dashed", "startBinding": { "elementId": "r_ship", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_66", "fixedPoint": [0.5, 0] }, "boundElements": [{ "id": "t_a7", "type": "text" }] },
    { "type": "text", "id": "t_a7", "x": 497, "y": 1198, "width": 120, "height": 20, "text": "on demand", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "textAlign": "center", "verticalAlign": "middle", "containerId": "a7", "originalText": "on demand", "autoResize": true },

    { "type": "rectangle", "id": "r_66", "x": 320, "y": 1250, "width": 340, "height": 100, "roundness": { "type": 3 }, "strokeStyle": "dashed", "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{ "id": "t_66", "type": "text" }] },
    { "type": "text", "id": "t_66", "x": 325, "y": 1260, "width": 330, "height": 80, "text": "#66 IMAGE PASS — inference on ground truth\nadjudicates declared + refused sites against\nthe page raster (scon · 10→no · erievance)\nbuilt when a real queue justifies it", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_66", "originalText": "#66 IMAGE PASS — inference on ground truth\nadjudicates declared + refused sites against\nthe page raster (scon · 10→no · erievance)\nbuilt when a real queue justifies it", "autoResize": true },

